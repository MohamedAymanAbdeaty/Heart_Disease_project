{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/predict",
      "destination": "/api/predict"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 30
    },
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "index.html"
    }
  }
}
