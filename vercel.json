{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/predict",
      "destination": "/api/predict"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{ai_pipeline.py,heart-disease.csv,index.html}"
    },
    "api/predict.py": {
      "maxDuration": 30,
      "includeFiles": "{ai_pipeline.py,heart-disease.csv}"
    },
    "api/health.py": {
      "maxDuration": 30,
      "includeFiles": "{ai_pipeline.py,heart-disease.csv}"
    }
  }
}
